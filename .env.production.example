# Written by CI/CD after each successful build or rollback selection.
IMAGE_PREFIX=ghcr.io/ridhurshan/tata-vision
IMAGE_TAG=latest

# Loopback port used by the deployment health check.
APP_PORT=8090

# Shared network used by the existing Caddy container.
PAAS_NETWORK=paas_paas

DB_NAME=tatavision
DB_USER=tatavision
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-at-least-32-random-characters

SAM_MODEL_PATH=/opt/tata-vision/models/sam_vit_h_4b8939.pth

EMAIL_USER=
EMAIL_APP_PASSWORD=
